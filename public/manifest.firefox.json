{
  "manifest_version": 3,
  "name": "AltVision",
  "version": "1.0.11",
  "description": "Empowering Visual Accessibility",
  "browser_specific_settings": {
    "gecko": {
      "id": "altvision@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon48.png",
      "180": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon48.png",
    "180": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "translationUtils.js", "content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": [
    "https://_YOUR_WORKER_DOMAIN_/*"
  ]
}
